{
  "name": "slots-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slots result engine (Game A Candy Koi Pond + Game B Hold & Spin). Step-wise pure-function engine, protocol v2. Zero runtime dependencies.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude test/rtp.test.ts",
    "sim": "bash scripts/runSim.sh",
    "sim:final": "bash scripts/finalSim.sh && bash scripts/finalMerge.sh",
    "analytic": "tsx scripts/analyticReport.ts",
    "report": "tsx scripts/makeReport.ts",
    "calibrate:A": "tsx scripts/calibrateA.ts",
    "calibrate:B": "tsx scripts/calibrateB.ts",
    "tune:B": "tsx scripts/tuneB.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}