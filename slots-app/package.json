{
  "name": "slots-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Candy Koi Pond slots – web client scaffold (PixiJS v8 + DOM shell), drives ../slots-engine",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "python3 scripts/copy-assets.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:debug": "VITE_ENABLE_DEBUG=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "measure": "node scripts/measure.mjs dist",
    "e2e:new": "node scripts/e2e-new.mjs",
    "e2e:showcase": "node scripts/e2e-showcase.mjs",
    "measure:fonts": "node scripts/measure-fonts.mjs",
    "sync:panel-copy": "node scripts/sync-panel-copy.mjs",
    "check:panel": "node scripts/check-panel-layout.mjs",
    "shoot:panel": "node scripts/shoot-panel.mjs && python3 scripts/compare-panel.py",
    "e2e:hs": "node scripts/check-hs-sync.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.2.0",
    "pixi.js": "^8.6.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.186.0",
    "jsdom": "^25.0.1",
    "playwright": "~1.49.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}